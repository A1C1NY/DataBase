TRANSIT_APP_ENV=development
TRANSIT_DEBUG=false

TRANSIT_DATABASE_URL=mysql+pymysql://transit_user:replace_me@127.0.0.1:3306/amap_transit?charset=utf8mb4

TRANSIT_JWT_SECRET=replace-with-at-least-32-random-characters
TRANSIT_JWT_EXPIRE_MINUTES=30

TRANSIT_AMAP_API_URL=https://restapi.amap.com/
TRANSIT_AMAP_API_KEY=
TRANSIT_UPSTREAM_TIMEOUT_SECONDS=10
TRANSIT_AMAP_MIN_REQUEST_INTERVAL_SECONDS=1.0
TRANSIT_AMAP_LINE_ID_MIN_REQUEST_INTERVAL_SECONDS=0.04
TRANSIT_AMAP_RATE_LIMIT_RETRIES=3
TRANSIT_AMAP_RATE_LIMIT_BACKOFF_SECONDS=0.5
TRANSIT_CITY_CODE=021

TRANSIT_CORS_ORIGINS=["http://localhost:5173"]
